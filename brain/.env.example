# ---- Brain server ----
PORT=4000

# ---- Keamanan webhook ----
# HMAC secret untuk verifikasi payload dari OpenWA (samakan di config webhook OpenWA).
# Kosongkan untuk MELEWATI verifikasi HMAC (hanya untuk test lokal via mock).
WA_WEBHOOK_SECRET=

# Whitelist nomor yang boleh pakai bot (comma-separated, format 628xxxx tanpa +).
# Kosong = izinkan semua (hanya untuk test lokal).
WA_ALLOWED_NUMBERS=

# ---- OpenWA Gateway (buat kirim balasan) ----
OPENWA_API_URL=http://localhost:2785
# Kosongkan OPENWA_API_KEY untuk MODE STUB: balasan hanya di-log ke console (test tanpa OpenWA).
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# ---- LLM via 9Router (OpenAI-compatible) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=cc/claude-opus-4-8

# ---- MCP Orkay (di-spawn Brain sebagai subprocess stdio) ----
MCP_ENTRY=../mcp/src/index.js
# Env yang diteruskan ke proses MCP:
ORKAY_API_URL=http://localhost:3001
ORKAY_PIN=123456
