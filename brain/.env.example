# ---- Brain server ----
PORT=4000

# ---- Keamanan webhook ----
# HMAC secret untuk verifikasi payload dari OpenWA (samakan di config webhook OpenWA).
# WAJIB di production: tanpa ini server REFUSE TO START & webhook fail-closed.
# Kosong hanya boleh di dev lokal DAN harus set WA_DEV_OPEN=1 (lihat di bawah).
WA_WEBHOOK_SECRET=

# Whitelist nomor yang boleh pakai bot (comma-separated, format 628xxxx tanpa +).
# WAJIB di production: tanpa ini server REFUSE TO START & semua nomor ditolak.
# Kosong hanya boleh di dev lokal DAN harus set WA_DEV_OPEN=1.
WA_ALLOWED_NUMBERS=

# Buka webhook TANPA secret/whitelist — HANYA untuk dev lokal. Set '1' untuk aktif.
# Diabaikan di production (NODE_ENV=production selalu fail-closed).
WA_DEV_OPEN=

# Rate limit per nomor WA (hemat token: tolak sebelum panggil LLM).
WA_RATE_MAX=15
WA_RATE_WINDOW_MS=60000

# ---- OpenWA Gateway (buat kirim balasan) ----
OPENWA_API_URL=http://localhost:2785
# Kosongkan OPENWA_API_KEY untuk MODE STUB: balasan hanya di-log ke console (test tanpa OpenWA).
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# ---- LLM via 9Router (OpenAI-compatible) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=cc/claude-opus-4-8

# Kontrol biaya & keandalan panggilan LLM.
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# ---- MCP Orkay (di-spawn Brain sebagai subprocess stdio) ----
MCP_ENTRY=../mcp/src/index.js
# Env yang diteruskan ke proses MCP:
ORKAY_API_URL=http://localhost:3001
ORKAY_PIN=123456
