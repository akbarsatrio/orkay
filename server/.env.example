# Salin file ini jadi .env lalu sesuaikan nilainya.
# cp .env.example .env

# Port tempat Express berjalan (di-proxy Nginx / Cloudflare Tunnel)
PORT=3001

# Mode: development | production
NODE_ENV=production

# PIN untuk masuk aplikasi. WAJIB GANTI dengan angka rahasia kamu.
# Di production server MENOLAK START kalau nilainya masih 123456.
APP_PIN=123456

# Rahasia untuk menandatangani token sesi. WAJIB diisi string acak panjang.
# Di production server MENOLAK START kalau masih nilai default.
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=ganti-dengan-string-acak-panjang

# Umur token sesi dalam milidetik (opsional). Default 30 hari.
# Token yang lebih tua dari nilai ini otomatis kadaluarsa (401 → login ulang).
# Set 0 untuk token abadi tanpa expiry. Contoh 7 hari = 604800000.
AUTH_TOKEN_TTL_MS=2592000000

# ---- Koneksi MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=economic_analytic

# Folder build React (default sudah benar untuk struktur repo ini)
CLIENT_DIST=../client/dist
